#!/bin/bash
set -euo pipefail

# Usage: ody-start [config [user [database]]]
# The config must enable daemonize. PGPORT defaults to 6432.
# ODYSSEY_BIN selects a different Odyssey binary.
config=${1:-/etc/odyssey/odyssey.conf}
user=${2:-postgres}
database=${3:-$user}

"${ODYSSEY_BIN:-/usr/bin/odyssey}" "$config"

MAX_RETRIES=50
COUNT=0

until pg_isready -h localhost -p "${PGPORT:-6432}" -U "$user" -d "$database"; do
  if [ $COUNT -ge $MAX_RETRIES ]; then
    echo "ERROR: Timeout waiting for Odyssey after $MAX_RETRIES attempts."
    ody-stop
    exit 1
  fi

  echo "Wait for odyssey... ($COUNT/$MAX_RETRIES)"
  sleep 0.1
  COUNT=$((COUNT+1))
done

echo "Odyssey is ready!"
