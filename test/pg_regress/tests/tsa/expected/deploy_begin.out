-- A rejected deferred BEGIN must not disconnect the client or run its query.
\pset format unaligned
SET odyssey.execute_on_host TO 'localhost:5433';
NOTICE:  processed virtually by odyssey
SET odyssey.parser_mode = 'full';
NOTICE:  processed virtually by odyssey
BEGIN READ WRITE;
SELECT 42;
ERROR:  cannot set transaction read-write mode during recovery
SELECT 43;
NOTICE:  select host tcp://localhost:5433
?column?
43
(1 row)
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT 44;
ERROR:  cannot use serializable mode in a hot standby
HINT:  You can use REPEATABLE READ instead.
SELECT 45;
NOTICE:  select host tcp://localhost:5433
?column?
45
(1 row)
