-- SET immediately after a virtual BEGIN must stay inside the transaction.
\pset format unaligned
SET application_name = 'before_tx';
BEGIN;
SET application_name = 'xx';
SHOW application_name;
application_name
xx - ::1
(1 row)
ROLLBACK;
SHOW application_name;
application_name
before_tx - ::1
(1 row)
