include "/home/postgres/regress/conf/_base"

log_config no

storage "rr-hosts" {
	type "remote"
	host "localhost:5432,localhost:5433,localhost:5434"
	endpoints_status_poll_interval 5000
	balancing {
		method "roundrobin" {}
		show_notice_messages yes
	}
}

storage "leastconn-hosts" {
	type "remote"
	host "localhost:5432,localhost:5433,localhost:5434"
	endpoints_status_poll_interval 5000
	balancing {
		method "leastconn" {}
		show_notice_messages yes
	}
}

database "postgres" {
	user "rruser" {
		authentication "none"
		storage "rr-hosts"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}

	user "leastconnuser" {
		authentication "none"
		storage "leastconn-hosts"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}

	user "postgres" {
		authentication "none"
		storage "leastconn-hosts"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}
}
