include "/home/postgres/regress/conf/_base"

log_config no

listen {
	host "*"
	port 7432
	backlog 128
	tls "disable"
	balancing {
		method "leastconn" {}
		show_notice_messages yes
	}
}

query_parsing {
	mode full
}

listen {
	host "*"
	port 8432
	backlog 128
	tls "disable"
	balancing {
		method "roundrobin" {}
		show_notice_messages yes
	}
	auto_route_ro_on_standby yes
}

listen {
	host "*"
	port 8433
	backlog 128
	tls "disable"
	balancing {
		method "roundrobin" {}
	}
	auto_route_ro_on_standby yes
}

storage "rr-hosts" {
	type "remote"
	host "localhost:5432,localhost:5433,localhost:5434"
	endpoints_status_poll_interval 5000
	balancing {
		method "roundrobin" {}
		show_notice_messages yes
	}
}

database "postgres" {
	user "rruser" {
		authentication "none"
		storage "rr-hosts"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}

	user "lcuser" {
		authentication "none"
		storage "rr-hosts"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}

	user "postgres" {
		authentication "none"
		storage "rr-hosts"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}
}
