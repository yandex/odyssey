include "/home/postgres/regress/conf/_base"

log_config no

listen {
	host "*"
	port 7432
	backlog 128
	compression yes
	tls "disable"
	target_session_attrs "read-only"
}

listen {
	host "*"
	port 8432
	backlog 128
	compression yes
	tls "disable"
	target_session_attrs "read-write"
}

storage "postgres_server" {
	type "remote"
	host "localhost:5432,localhost:5433,localhost:5434"
	endpoints_status_poll_interval 5000
	balancing {
		method "roundrobin" {}
		show_notice_messages yes
	}
}

storage "only_rw_alive" {
	type "remote"
	host "localhost:5432,localhost:5430"
	endpoints_status_poll_interval 5000
	balancing {
		method "roundrobin" {}
		show_notice_messages yes
	}
}

database "postgres" {
	user "postgres" {
		authentication "none"
		storage "postgres_server"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
	}

	user "rouser" {
		authentication "none"
		storage "postgres_server"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
		target_session_attrs "read-only"
	}

	user "rwuser" {
		authentication "none"
		storage "postgres_server"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
		target_session_attrs "read-write"
	}

	user "preferstandbyuser-rw" {
		authentication "none"
		storage "only_rw_alive"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
		target_session_attrs "prefer-standby"
	}

	user "preferstandbyuser-ro" {
		authentication "none"
		storage "postgres_server"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 1000
		client_show_id no
		target_session_attrs "prefer-standby"
	}
}
