include "/home/postgres/regress/conf/_base"

log_config yes

storage "postgres_server" {
	type "remote"
	host "localhost:5432"
	endpoints_status_poll_interval 5000
}

database "postgres" {
	user "suser" {
		authentication "none"
		storage "postgres_server"
		storage_user "postgres"
		pool "session"
		pool_size 32
		pool_timeout 0
		pool_ttl 1201
		pool_discard yes
		pool_cancel yes
		pool_rollback yes
		pool_reserve_prepared_statement yes
		pool_client_idle_timeout 4
		pool_idle_in_transaction_timeout 5
		client_fwd_error yes
		client_show_id no
		application_name_add_host yes
		server_lifetime 1901
		log_debug no
		client_max 200000
	}

	user "tuser" {
		authentication "none"
		storage "postgres_server"
		storage_user "postgres"
		pool "transaction"
		pool_size 32
		pool_timeout 0
		pool_ttl 1201
		pool_discard yes
		pool_cancel yes
		pool_rollback yes
		pool_reserve_prepared_statement yes
		pool_client_idle_timeout 4
		pool_idle_in_transaction_timeout 5
		client_fwd_error yes
		client_show_id no
		application_name_add_host yes
		server_lifetime 1901
		log_debug no
		client_max 200000
		pool_pin_on_listen yes
	}

	user "stuser" {
		authentication "none"
