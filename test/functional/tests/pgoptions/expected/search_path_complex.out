\set ON_ERROR_STOP on
\pset format unaligned
\pset tuples_only on
SELECT current_setting('search_path') = '"odyssey-test-path", "odyssey_кириллица", public' AS startup_path;
t
CREATE SCHEMA "odyssey-test-path";
CREATE SCHEMA "odyssey_кириллица";
SELECT current_schemas(false) = ARRAY['odyssey-test-path', 'odyssey_кириллица', 'public']::name[] AS schema_order;
t
\! PGOPTIONS='-c search_path=pg_catalog' psql -XqAt -v ON_ERROR_STOP=1 -c "SELECT current_setting('search_path') = 'pg_catalog'"
t
\if :SHELL_ERROR
SELECT 1/0;
\endif
SELECT current_setting('search_path') = '"odyssey-test-path", "odyssey_кириллица", public' AS restored_path;
t
SELECT current_schemas(false) = ARRAY['odyssey-test-path', 'odyssey_кириллица', 'public']::name[] AS restored_order;
t
DROP SCHEMA "odyssey-test-path";
DROP SCHEMA "odyssey_кириллица";
